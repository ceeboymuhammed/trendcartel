<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="tc-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6D28D9" />
      <stop offset="100%" stop-color="#4C1D95" />
    </linearGradient>
    <linearGradient id="tc-accent" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10B981" />
      <stop offset="100%" stop-color="#FBBF24" />
    </linearGradient>
  </defs>

  <!-- Rounded Squircle Background -->
  <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#tc-bg)" />

  <!-- Subtle Inner Highlight Border -->
  <rect x="3.5" y="3.5" width="57" height="57" rx="14.5" fill="none" stroke="#FFFFFF" stroke-opacity="0.15" stroke-width="1.5" />

  <!-- Bold Geometric "T" Monogram -->
  <path d="M15 21 H37 V27 H29 V46 H23 V27 H15 Z" fill="#FFFFFF" />

  <!-- Upward Growth Trend Spark / Arrow on the Right -->
  <path d="M35 39 L43 31 L47 35 L53 26" fill="none" stroke="url(#tc-accent)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M46 25 H54 V33" fill="none" stroke="#FBBF24" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>